{
  "name": "@aurelienbbn/agentlint",
  "version": "0.2.0",
  "description": "Deterministic triggers for contextual agent guidance and accountable resolution",
  "keywords": [
    "agent",
    "ai",
    "ast",
    "code-review",
    "linter",
    "tanstack-intent",
    "tree-sitter"
  ],
  "homepage": "https://github.com/aurelienbobenrieth/agentlint/tree/main/packages/agentlint",
  "bugs": {
    "url": "https://github.com/aurelienbobenrieth/agentlint/issues"
  },
  "license": "MIT",
  "author": "Aurelien Bobenrieth",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelienbobenrieth/agentlint",
    "directory": "packages/agentlint"
  },
  "bin": {
    "agentlint": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm --filter @agentlint/review build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.85",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@shopify/liquid-html-parser": "^2.9.2",
    "effect": "4.0.0-beta.85",
    "jiti": "^2.7.0",
    "picomatch": "^4.0.4",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@tanstack/intent": "latest",
    "@types/node": "^22.20.0",
    "@types/picomatch": "^4.0.3",
    "tree-sitter-wasms": "^0.1.13",
    "tsdown": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
