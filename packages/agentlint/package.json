{
  "name": "@aurelienbbn/agentlint",
  "version": "0.1.5",
  "description": "Deterministic findings and explicit judgment gates for coding agents",
  "keywords": [
    "agent",
    "ai",
    "code-review",
    "guardrails",
    "judgment",
    "tanstack-intent",
    "tree-sitter"
  ],
  "homepage": "https://github.com/aurelienbobenrieth/agentlint/tree/main/packages/agentlint",
  "bugs": {
    "url": "https://github.com/aurelienbobenrieth/agentlint/issues"
  },
  "license": "MIT",
  "author": "Aurelien Bobenrieth",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelienbobenrieth/agentlint",
    "directory": "packages/agentlint"
  },
  "bin": {
    "agentlint": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./contract": {
      "source": "./src/features/review/contract.ts",
      "types": "./dist/contract.d.mts",
      "import": "./dist/contract.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm --filter @agentlint/review build",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:",
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@tanstack/intent": "catalog:",
    "@types/node": "26.4.0",
    "@types/picomatch": "4.0.3",
    "tree-sitter-wasms": "0.1.13",
    "tsdown": "0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
